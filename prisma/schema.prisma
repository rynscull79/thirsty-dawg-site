// === prisma/schema.prisma ===
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id               Int      @id @default(autoincrement())
  name             String
  email            String
  phone            String
  street           String
  city             String
  state            String
  zip              String
  dateNeeded       DateTime
  guestCount       Int
  rentalLength     String
  machineType      String
  flavor           String
  flavorAdditions  String?
  comments         String?
  createdAt        DateTime @default(now())
}
